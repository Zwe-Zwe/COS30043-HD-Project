{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nexport default {\n  name: 'MainView',\n  data() {\n    return {\n      featuredBooks: [],\n      newArrivals: [],\n      selectedGenre: 'All',\n      genres: ['All', 'Fiction', 'Self-help']\n    };\n  },\n  computed: {\n    filteredFeaturedBooks() {\n      if (this.selectedGenre === 'All') {\n        return this.featuredBooks;\n      }\n      return this.featuredBooks.filter(book => book.genre === this.selectedGenre);\n    },\n    filteredNewArrivals() {\n      if (this.selectedGenre === 'All') {\n        return this.newArrivals;\n      }\n      return this.newArrivals.filter(book => book.genre === this.selectedGenre);\n    }\n  }\n};","map":{"version":3,"names":["name","data","featuredBooks","newArrivals","selectedGenre","genres","computed","filteredFeaturedBooks","filter","book","genre","filteredNewArrivals"],"sources":["C:\\Users\\zweht\\OneDrive\\Desktop\\InterfaceProject\\booknest\\src\\views\\MainView.vue"],"sourcesContent":["<template>\n  <section class=\"bg-primary text-white text-center py-5\">\n    <div class=\"container\">\n      <h1>Welcome to BookNest 📚</h1>\n      <p>Your cozy online bookstore. Discover, read, repeat.</p>\n    </div>\n  </section>\n\n  <div class=\"container mt-4\">\n    <div class=\"row mb-3\">\n      <div class=\"col-md-4\">\n        <label for=\"genreFilter\" class=\"form-label\">Filter by Genre</label>\n        <select id=\"genreFilter\" class=\"form-select\" v-model=\"selectedGenre\">\n          <option v-for=\"genre in genres\" :key=\"genre\" :value=\"genre\">\n            {{ genre }}\n          </option>\n        </select>\n      </div>\n    </div>\n  </div>\n\n\n  <section class=\"container my-5\">\n    <h2>🌟 Featured Books</h2>\n    <div class=\"row\">\n      <div class=\"col-md-3\" v-for=\"book in filteredFeaturedBooks\" :key=\"book.id\">\n        <router-link :to=\"`/product/${book.id}`\" class=\"text-decoration-none text-dark\">\n          <div class=\"card h-100\">\n            <img :src=\"book.image\" class=\"card-img-top\" alt=\"book cover\">\n            <div class=\"card-body\">\n              <h5 class=\"card-title\">{{ book.title }}</h5>\n              <p class=\"card-text\">{{ book.author }}</p>\n              <p class=\"card-text text-primary\">$ {{ book.price.toFixed(2) }}</p>\n            </div>\n          </div>\n        </router-link>\n      </div>\n    </div>\n  </section>\n\n  <!-- New Arrivals Section -->\n  <section class=\"container my-5\">\n    <h2>🆕 New Arrivals</h2>\n    <div class=\"row\">\n      <div class=\"col-md-3\" v-for=\"book in filteredNewArrivals\" :key=\"book.id\">\n        <router-link :to=\"`/product/${book.id}`\" class=\"text-decoration-none text-dark\">\n          <div class=\"card h-100\">\n            <img :src=\"book.image\" class=\"card-img-top\" alt=\"book cover\">\n            <div class=\"card-body\">\n              <h5 class=\"card-title\">{{ book.title }}</h5>\n              <p class=\"card-text\">{{ book.author }}</p>\n              <p class=\"card-text text-primary\">$ {{ book.price.toFixed(2) }}</p>\n            </div>\n          </div>\n        </router-link>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script>\nexport default {\n  name: 'MainView',\n  data() {\n  return {\n    featuredBooks: [],\n    newArrivals: [],\n    selectedGenre: 'All',\n    genres: ['All', 'Fiction', 'Self-help']\n  };\n}\n,\n  computed: {\n  filteredFeaturedBooks() {\n    if (this.selectedGenre === 'All') {\n      return this.featuredBooks;\n    }\n    return this.featuredBooks.filter(book => book.genre === this.selectedGenre);\n  },\n  filteredNewArrivals() {\n    if (this.selectedGenre === 'All') {\n      return this.newArrivals;\n    }\n    return this.newArrivals.filter(book => book.genre === this.selectedGenre);\n  }\n}\n\n};\n</script>"],"mappings":";;AA6DA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACP,OAAO;MA