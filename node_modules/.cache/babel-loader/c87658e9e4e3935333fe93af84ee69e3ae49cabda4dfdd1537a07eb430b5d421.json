{"ast":null,"code":"export default {\n  name: 'MainView',\n  data() {\n    return {\n      featuredBooks: [{\n        id: 1,\n        title: 'The Silent Patient',\n        author: 'Alex Michaelides',\n        genre: 'Thriller',\n        price: 15.99,\n        image: 'book1.jpg'\n      }, {\n        id: 2,\n        title: 'Atomic Habits',\n        author: 'James Clear',\n        genre: 'Self-help',\n        price: 12.99,\n        image: 'book2.jpg'\n      }\n      // add more...\n      ],\n      newArrivals: [{\n        id: 3,\n        title: 'The Midnight Library',\n        author: 'Matt Haig',\n        genre: 'Fiction',\n        price: 14.99,\n        image: 'book3.jpg'\n      }, {\n        id: 4,\n        title: 'Educated',\n        author: 'Tara Westover',\n        genre: 'Memoir',\n        price: 13.99,\n        image: 'book4.jpg'\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","featuredBooks","id","title","author","genre","price","image","newArrivals"],"sources":["C:\\Users\\zweht\\OneDrive\\Desktop\\InterfaceProject\\booknest\\src\\views\\MainView.vue"],"sourcesContent":["<template>\n  <section class=\"bg-primary text-white text-center py-5\">\n    <div class=\"container\">\n      <h1>Welcome to BookNest 📚</h1>\n      <p>Your cozy online bookstore. Discover, read, repeat.</p>\n    </div>\n  </section>\n\n  <section class=\"container my-5\">\n    <h2>🌟 Featured Books</h2>\n    <div class=\"row\">\n      <div class=\"col-md-3\" v-for=\"book in featuredBooks\" :key=\"book.id\">\n        <div class=\"card h-100\">\n          <img :src=\"require(`@/assets/${book.image}`)\" class=\"card-img-top\" alt=\"book cover\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">{{ book.title }}</h5>\n            <p class=\"card-text\">{{ book.author }}</p>\n            <p class=\"card-text text-primary\">$ {{ book.price.toFixed(2) }}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- New Arrivals Section -->\n  <section class=\"container my-5\">\n    <h2>🆕 New Arrivals</h2>\n    <div class=\"row\">\n      <div class=\"col-md-3\" v-for=\"book in newArrivals\" :key=\"book.id\">\n        <div class=\"card h-100\">\n          <img :src=\"require(`@/assets/${book.image}`)\" class=\"card-img-top\" alt=\"book cover\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">{{ book.title }}</h5>\n            <p class=\"card-text\">{{ book.author }}</p>\n            <p class=\"card-text text-primary\">$ {{ book.price.toFixed(2) }}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script>\nexport default {\n  name: 'MainView',\n  data() {\n    return {\n      featuredBooks: [\n        { id: 1, title: 'The Silent Patient', author: 'Alex Michaelides', genre: 'Thriller', price: 15.99, image: 'book1.jpg' },\n        { id: 2, title: 'Atomic Habits', author: 'James Clear', genre: 'Self-help', price: 12.99, image: 'book2.jpg' }\n        // add more...\n      ],\n      newArrivals: [\n        { id: 3, title: 'The Midnight Library', author: 'Matt Haig', genre: 'Fiction', price: 14.99, image: 'book3.jpg' },\n        { id: 4, title: 'Educated', author: 'Tara Westover', genre: 'Memoir', price: 13.99, image: 'book4.jpg' }\n      ]\n    };\n  },\n};\n</script>"],"mappings":"AA2CA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE,CACb;QAAEC,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,oBAAoB;QAAEC,MAAM,EAAE,kBAAkB;QAAEC,KAAK,EAAE,UAAU;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAAY,CAAC,EACvH;QAAEL,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,eAAe;QAAEC,MAAM,EAAE,aAAa;QAAEC,KAAK,EAAE,WAAW;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAAY;MAC7G;MAAA,CACD;MACDC,WAAW,EAAE,CACX;QAAEN,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,sBAAsB;QAAEC,MAAM,EAAE,WAAW;QAAEC,KAAK,EAAE,SAAS;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAAY,CAAC,EACjH;QAAEL,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,UAAU;QAAEC,MAAM,EAAE,eAAe;QAAEC,KAAK,EAAE,QAAQ;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAAY;I