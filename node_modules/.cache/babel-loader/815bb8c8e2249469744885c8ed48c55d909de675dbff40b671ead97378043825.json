{"ast":null,"code":"export default {\n  name: 'ProductDetails',\n  data() {\n    return {\n      book: null\n    };\n  },\n  mounted() {\n    const bookId = this.$route.params.id;\n    fetch(`http://localhost:3000/books/${bookId}`).then(res => res.json()).then(data => {\n      this.book = data;\n    }).catch(err => {\n      console.error('Error fetching book:', err);\n    });\n  }\n};","map":{"version":3,"names":["name","data","book","mounted","bookId","$route","params","id","fetch","then","res","json","catch","err","console","error"],"sources":["C:\\Users\\zweht\\OneDrive\\Desktop\\InterfaceProject\\booknest\\src\\views\\ProductDetails.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"book\" class=\"container my-5\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-4\">\r\n        <img :src=\"book.imageLink\" class=\"card-img-top\" alt=\"book cover\">/\r\n      </div>\r\n      <div class=\"col-md-8\">\r\n        \r\n        <h2>{{ book.title }}</h2>\r\n        <h5 class=\"text-muted\">{{ book.author }}</h5>\r\n        <p class=\"text-primary h5\">$ {{ book.price.toFixed(2) }}</p>\r\n        <button class=\"btn btn-success mt-3\">Add to Cart</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div v-else class=\"container text-center my-5\">\r\n    <p>Loading book details...</p>\r\n  </div>\r\n</template>\r\n\r\n\r\n<script>\r\nexport default {\r\n  name: 'ProductDetails',\r\n  data() {\r\n    return {\r\n      book: null\r\n    };\r\n  },\r\n  mounted() {\r\n    const bookId = this.$route.params.id;\r\n    fetch(`http://localhost:3000/books/${bookId}`)\r\n      .then(res => res.json())\r\n      .then(data => {\r\n        this.book = data;\r\n      })\r\n      .catch(err => {\r\n        console.error('Error fetching book:', err);\r\n      });\r\n  },\r\n};\r\n</script>\r\n\r\n"],"mappings":"AAsBA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAI,IAAI,CAACC,MAAM,CA