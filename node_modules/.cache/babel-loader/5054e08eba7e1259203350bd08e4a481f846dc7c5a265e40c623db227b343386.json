{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nexport default {\n  name: 'MainView',\n  data() {\n    return {\n      selectedGenre: 'All',\n      genres: ['All', 'Thriller', 'Self-help', 'Fiction', 'Memoir'],\n      featuredBooks: [{\n        id: 1,\n        title: 'The Silent Patient',\n        author: 'Alex Michaelides',\n        genre: 'Thriller',\n        price: 15.99,\n        image: 'https://picsum.photos/150'\n      }, {\n        id: 2,\n        title: 'Atomic Habits',\n        author: 'James Clear',\n        genre: 'Self-help',\n        price: 12.99,\n        image: 'https://picsum.photos/150'\n      }\n      // add more...\n      ],\n      newArrivals: [{\n        id: 3,\n        title: 'The Midnight Library',\n        author: 'Matt Haig',\n        genre: 'Fiction',\n        price: 14.99,\n        image: 'https://picsum.photos/150'\n      }, {\n        id: 4,\n        title: 'Educated',\n        author: 'Tara Westover',\n        genre: 'Memoir',\n        price: 13.99,\n        image: 'https://picsum.photos/150'\n      }]\n    };\n  },\n  computed: {\n    filteredFeaturedBooks() {\n      if (this.selectedGenre === 'All') {\n        return this.featuredBooks;\n      }\n      return this.featuredBooks.filter(book => book.genre === this.selectedGenre);\n    },\n    filteredNewArrivals() {\n      if (this.selectedGenre === 'All') {\n        return this.newArrivals;\n      }\n      return this.newArrivals.filter(book => book.genre === this.selectedGenre);\n    }\n  }\n};","map":{"version":3,"names":["name","data","selectedGenre","genres","featuredBooks","id","title","author","genre","price","image","newArrivals","computed","filteredFeaturedBooks","filter","book","filteredNewArrivals"],"sources":["C:\\Users\\zweht\\OneDrive\\Desktop\\InterfaceProject\\booknest\\src\\views\\MainView.vue"],"sourcesContent":["<template>\n  <section class=\"bg-primary text-white text-center py-5\">\n    <div class=\"container\">\n      <h1>Welcome to BookNest 📚</h1>\n      <p>Your cozy online bookstore. Discover, read, repeat.</p>\n    </div>\n  </section>\n\n  <div class=\"container mt-4\">\n    <div class=\"row mb-3\">\n      <div class=\"col-md-4\">\n        <label for=\"genreFilter\" class=\"form-label\">Filter by Genre</label>\n        <select id=\"genreFilter\" class=\"form-select\" v-model=\"selectedGenre\">\n          <option v-for=\"genre in genres\" :key=\"genre\" :value=\"genre\">\n            {{ genre }}\n          </option>\n        </select>\n      </div>\n    </div>\n  </div>\n\n  <section class=\"container my-5\">\n    <h2>🌟 Featured Books</h2>\n    <div class=\"row\">\n      <div class=\"col-md-3\" v-for=\"book in filteredFeaturedBooks\" :key=\"book.id\">\n        <div class=\"card h-100\">\n          <img :src=\"book.image\" class=\"card-img-top\" alt=\"book cover\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">{{ book.title }}</h5>\n            <p class=\"card-text\">{{ book.author }}</p>\n            <p class=\"card-text text-primary\">$ {{ book.price.toFixed(2) }}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- New Arrivals Section -->\n  <section class=\"container my-5\">\n    <h2>🆕 New Arrivals</h2>\n    <div class=\"row\">\n      <div class=\"col-md-3\" v-for=\"book in filteredNewArrivals\" :key=\"book.id\">\n        <div class=\"card h-100\">\n          <img :src=\"book.image\" class=\"card-img-top\" alt=\"book cover\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">{{ book.title }}</h5>\n            <p class=\"card-text\">{{ book.author }}</p>\n            <p class=\"card-text text-primary\">$ {{ book.price.toFixed(2) }}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script>\nexport default {\n  name: 'MainView',\n  data() {\n    return {\n      selectedGenre: 'All',\n      genres: ['All', 'Thriller', 'Self-help', 'Fiction', 'Memoir'],\n      featuredBooks: [\n        { id: 1, title: 'The Silent Patient', author: 'Alex Michaelides', genre: 'Thriller', price: 15.99, image: 'https://picsum.photos/150' },\n        { id: 2, title: 'Atomic Habits', author: 'James Clear', genre: 'Self-help', price: 12.99, image: 'https://picsum.photos/150' }\n        // add more...\n      ],\n      newArrivals: [\n        { id: 3, title: 'The Midnight Library', author: 'Matt Haig', genre: 'Fiction', price: 14.99, image: 'https://picsum.photos/150' },\n        { id: 4, title: 'Educated', author: 'Tara Westover', genre: 'Memoir', price: 13.99, image: 'https://picsum.photos/150' }\n      ]\n    };\n  },\n  computed: {\n  filteredFeaturedBooks() {\n    if (this.selectedGenre === 'All') {\n      return this.featuredBooks;\n    }\n    return this.featuredBooks.filter(book => book.genre === this.selectedGenre);\n  },\n  filteredNewArrivals() {\n    if (this.selectedGenre === 'All') {\n      return this.newArrivals;\n    }\n    return this.newArrivals.filter(book => book.genre === this.selectedGenre);\n  }\n}\n\n};\n</script>"],"mappings":";;AAwDA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,aAAa,EAAE,KAAK;MACpBC,MAAM,EAAE,CAAC,KAAK,EAAE,UAAU,EAAE,WAAW,EAAE,SAAS,EAAE,QAAQ,CAAC;MAC7DC,aAAa,EAAE,CACb;QAAEC,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,oBAAoB;QAAEC,MAAM,EAAE,kBAAkB;QAAEC,KAAK,EAAE,UAAU;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA4B,CAAC,EACvI;QAAEL,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,eAAe;QAAEC,MAAM,EAAE,aAAa;QAAEC,KAAK,EAAE,WAAW;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA4B;MAC7H;MAAA,CACD;MACDC,WAAW,EAAE,CACX;QAAEN,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,sBAAsB;QAAEC,MAAM,EAAE,WAAW;QAAEC,KAAK,EAAE,SAAS;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA4B,CAAC,EACjI;QAAEL,EAAE,EAAE,CAAC;QAAEC,KAAK,EAAE,UAAU;QAAEC,MAAM,EAAE,eAAe;QAAEC,KAAK,EAAE,QAAQ;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA4B;IAE3H,CAAC;EACH,CAAC;EACDE,QAAQ,EAAE;IACVC,qBAAqBA,CAAA,EAAG;MACtB,IAAI,IAAI,CAACX,aAAY,KAAM,KAAK,EAAE;QAChC,O