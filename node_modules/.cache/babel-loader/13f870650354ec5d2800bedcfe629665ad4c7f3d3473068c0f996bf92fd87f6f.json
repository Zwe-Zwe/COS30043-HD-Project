{"ast":null,"code":"export default {\n  name: 'ProductDetails',\n  data() {\n    return {\n      book: null\n    };\n  },\n  mounted() {\n    const bookId = this.$route.params.id;\n    // later: fetch real data from JSON server\n    // for now: simulate lookup\n    this.loadBook(bookId);\n  },\n  methods: {\n    loadBook(id) {\n      // Simulated book list (later from backend)\n      const sampleBooks = [{\n        id: 1,\n        title: 'The Silent Patient',\n        author: 'Alex Michaelides',\n        genre: 'Thriller',\n        price: 15.99,\n        image: 'https://picsum.photos/150'\n      }, {\n        id: 2,\n        title: 'Atomic Habits',\n        author: 'James Clear',\n        genre: 'Self-help',\n        price: 12.99,\n        image: 'https://picsum.photos/150'\n      }, {\n        id: 3,\n        title: 'The Midnight Library',\n        author: 'Matt Haig',\n        genre: 'Fiction',\n        price: 14.99,\n        image: 'https://picsum.photos/150'\n      }, {\n        id: 4,\n        title: 'Educated',\n        author: 'Tara Westover',\n        genre: 'Memoir',\n        price: 13.99,\n        image: 'https://picsum.photos/150'\n      }];\n      this.book = sampleBooks.find(book => book.id === Number(id));\n    }\n  }\n};","map":{"version":3,"names":["name","data","book","mounted","bookId","$route","params","id","loadBook","methods","sampleBooks","title","author","genre","price","image","find","Number"],"sources":["C:\\Users\\zweht\\OneDrive\\Desktop\\InterfaceProject\\booknest\\src\\views\\ProductDetails.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"book\" class=\"container my-5\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-4\">\r\n        <img :src=\"book.image\" class=\"card-img-top\" alt=\"book cover\">\r\n      </div>\r\n      <div class=\"col-md-8\">\r\n        \r\n        <h2>{{ book.title }}</h2>\r\n        <h5 class=\"text-muted\">{{ book.author }}</h5>\r\n        <p class=\"text-primary h5\">$ {{ book.price.toFixed(2) }}</p>\r\n        <button class=\"btn btn-success mt-3\">Add to Cart</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div v-else class=\"container text-center my-5\">\r\n    <p>Loading book...</p>\r\n  </div>\r\n</template>\r\n\r\n\r\n<script>\r\nexport default {\r\n  name: 'ProductDetails',\r\n  data() {\r\n    return {\r\n      book: null\r\n    };\r\n  },\r\n  mounted() {\r\n    const bookId = this.$route.params.id;\r\n    // later: fetch real data from JSON server\r\n    // for now: simulate lookup\r\n    this.loadBook(bookId);\r\n  },\r\n  methods: {\r\n    loadBook(id) {\r\n      // Simulated book list (later from backend)\r\n      const sampleBooks = [\r\n        { id: 1, title: 'The Silent Patient', author: 'Alex Michaelides', genre: 'Thriller', price: 15.99, image: 'https://picsum.photos/150' },\r\n        { id: 2, title: 'Atomic Habits', author: 'James Clear', genre: 'Self-help', price: 12.99, image: 'https://picsum.photos/150' },\r\n        { id: 3, title: 'The Midnight Library', author: 'Matt Haig', genre: 'Fiction', price: 14.99, image: 'https://picsum.photos/150' },\r\n        { id: 4, title: 'Educated', author: 'Tara Westover', genre: 'Memoir', price: 13.99, image: 'https://picsum.photos/150' }\r\n      ];\r\n      this.book = sampleBooks.find(book => book.id === Number(id));\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n"],"mappings":"AAsBA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACC,EAAE;IACpC;IACA;IACA,IAAI,CAACC,QAAQ,CAACJ,MAAM,CAAC;EACvB,CAAC;EACDK,OAAO,EAAE;IACPD,QAAQA,CAACD,EAAE,EAAE;MACX;MACA,MAAMG,WAAU,GAAI,CAClB;QAAEH,EAAE,EAAE,CAAC;QAAEI,KAAK,EAAE,oBAAoB;QAAEC,MAAM,EAAE,kBAAkB;QAAEC,KAAK,EAAE,UAAU;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA4B,CAAC,EACvI;QAAER,EAAE,EAAE,CAAC;QAAEI,KAAK,EAAE,eAAe;QAAEC,MAAM,EAAE,aAAa;QAAEC,KAAK,EAAE,WAAW;QAAEC,KAAK,EAAE,KAAK;QAAEC,KAAK,EAAE;MAA4B,CAAC,EAC9H;QAAER,EAAE,EAAE,CAAC;QAAEI,K