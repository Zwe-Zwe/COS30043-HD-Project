{"ast":null,"code":"export default {\n  name: 'ProductDetails',\n  data() {\n    return {\n      book: null\n    };\n  },\n  mounted() {\n    const bookId = this.$route.params.id;\n    fetch(`http://localhost:3000/books/${bookId}`).then(res => {\n      if (!res.ok) {\n        throw new Error(`Book not found: ${res.status} ${res.statusText}`);\n      }\n      return res.json();\n    }).then(data => {\n      this.book = {\n        ...data,\n        image: `/${data.imageLink}`,\n        // Prepend / to make absolute path\n        id: String(data.id),\n        // Ensure id is string\n        link: data.link ? data.link.trim() : '' // Clean up trailing \\n\n      };\n    }).catch(err => {\n      console.error('Error fetching book:', err);\n      this.book = null; // Ensure loading state clears on error\n    });\n  }\n};","map":{"version":3,"names":["name","data","book","mounted","bookId","$route","params","id","fetch","then","res","ok","Error","status","statusText","json","image","imageLink","String","link","trim","catch","err","console","error"],"sources":["C:\\Users\\zweht\\OneDrive\\Desktop\\InterfaceProject\\booknest\\src\\views\\ProductDetails.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"book\" class=\"container my-5\">\r\n    <div class=\"row\">\r\n      <div class=\"col-md-4\">\r\n        <img :src=\"book.imageLink\" class=\"card-img-top\" alt=\"book cover\">\r\n      </div>\r\n      <div class=\"col-md-8\">\r\n        \r\n        <h2>{{ book.title }}</h2>\r\n        <h5 class=\"text-muted\">{{ book.author }}</h5>\r\n        <p class=\"text-primary h5\">$ {{ book.price.toFixed(2) }}</p>\r\n        <button class=\"btn btn-success mt-3\">Add to Cart</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div v-else class=\"container text-center my-5\">\r\n    <p>Loading book details...</p>\r\n  </div>\r\n</template>\r\n\r\n\r\n<script>\r\nexport default {\r\n  name: 'ProductDetails',\r\n  data() {\r\n    return {\r\n      book: null\r\n    };\r\n  },\r\n  mounted() {\r\n    const bookId = this.$route.params.id;\r\n    fetch(`http://localhost:3000/books/${bookId}`)\r\n      .then(res => {\r\n        if (!res.ok) {\r\n          throw new Error(`Book not found: ${res.status} ${res.statusText}`);\r\n        }\r\n        return res.json();\r\n      })\r\n      .then(data => {\r\n        this.book = {\r\n          ...data,\r\n          image: `/${data.imageLink}`, // Prepend / to make absolute path\r\n          id: String(data.id), // Ensure id is string\r\n          link: data.link ? data.link.trim() : '' // Clean up trailing \\n\r\n        };\r\n      })\r\n      .catch(err => {\r\n        console.error('Error fetching book:', err);\r\n        this.book = null; // Ensure loading state clears on error\r\n      });\r\n  },\r\n};\r\n</script>\r\n\r\n"],"mappings":"AAsBA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,MAAK,GAAI,IAAI,CAACC,MAAM,CAACC,MAAM,CAACC,EAAE;IACpCC,KAAK,CAAC,+BAA+BJ,MAAM,EAAE,EAC1CK,IAAI,CAACC,GAAE,IAAK;MACX,IAAI,CAACA,GAAG,CAACC,EAAE,EAAE;QACX,MAAM,IAAIC,KAAK,CAAC,mBAAmBF,GAAG,CAACG,MAAM,IAAIH,GAAG,CAACI,UAAU,EAAE,CAAC;MACpE;MACA,OAAOJ,GAAG,CAACK,IAAI,CAAC,CAAC;IACnB,CAAC,EACAN,IAAI,CAACR,IAAG,IAAK;MACZ,IAAI,CAACC,IAAG,GAAI;QACV,GAAGD,IAAI;QACPe,KAAK,EAAE,IAAIf,IAAI,CAACgB,SAAS,EAAE;QAAE;QAC7BV,EAAE,EAAEW,MAAM,CAACjB,IAAI,CAACM,EAAE,CAAC;QAAE;QACrBY,IAAI,EAAElB,IAAI,CAACkB,IAAG,GAAIlB,IAAI,CAACkB,IAAI,CAACC,IAAI,CAAC,IAAI,EAAC,CAAE;MAC1C,CAAC;IACH,CAAC,EACAC,KAAK,CAACC,GAAE,IAAK;MACZC,OAAO,CAACC,KAAK,CAAC,sBAAsB,EAAEF,GAAG,CAAC;MAC1C,IAAI,CAACpB,IAAG,GAAI,IAAI,EAAE;IACpB,CAAC,CAAC;EACN;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}